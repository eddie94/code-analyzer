          "default": null,
          "title": "Line"
        },
        "type_only": {
          "default": false,
          "title": "Type Only",
          "type": "boolean"
        },
        "lazy": {
          "default": false,
          "title": "Lazy",
          "type": "boolean"
        },
        "conditional": {
          "default": false,
          "title": "Conditional",
          "type": "boolean"
